# ─────────────────────────────────────────────────────────────
# QuantNexa SOAR·AI — environment template
# Copy to .env and fill in. NEVER commit the populated file.
# ─────────────────────────────────────────────────────────────

# ── Core ──
SOAR_ENVIRONMENT=development
SOAR_LOG_LEVEL=INFO
SOAR_DEBUG=false

# ── Security ──
# Generate with: openssl rand -hex 32
SOAR_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
SOAR_ACCESS_TOKEN_TTL_MINUTES=60
SOAR_REFRESH_TOKEN_TTL_DAYS=14
SOAR_CORS_ORIGINS=http://localhost:5173
SOAR_WEBHOOK_HMAC_SECRET=change-me-webhook-hmac-secret

# ── Datastores ──
SOAR_DATABASE_URL=postgresql+asyncpg://soar:soar@localhost:5432/soar
SOAR_REDIS_URL=redis://localhost:6379/0

# ── Anthropic (agent brain) ──
SOAR_ANTHROPIC_API_KEY=
SOAR_ANTHROPIC_MODEL=claude-sonnet-4-6
SOAR_ANTHROPIC_MAX_TOKENS=2000
SOAR_ANTHROPIC_TEMPERATURE=0.1
SOAR_AGENT_MAX_ITERATIONS=6

# ── RAG ──
SOAR_EMBEDDING_PROVIDER=hashing        # hashing | voyage | openai
SOAR_EMBEDDING_DIMENSIONS=768
SOAR_VOYAGE_API_KEY=
SOAR_OPENAI_API_KEY=
SOAR_RAG_TOP_K=4
SOAR_RAG_CHUNK_SIZE=256
SOAR_RAG_CHUNK_OVERLAP=50

# ── Integrations ──
SOAR_SPLUNK_URL=
SOAR_SPLUNK_TOKEN=
SOAR_ELASTIC_URL=
SOAR_ELASTIC_API_KEY=
SOAR_CROWDSTRIKE_CLIENT_ID=
SOAR_CROWDSTRIKE_CLIENT_SECRET=
SOAR_VIRUSTOTAL_API_KEY=
SOAR_ABUSEIPDB_API_KEY=
SOAR_OTX_API_KEY=
SOAR_MISP_URL=
SOAR_MISP_API_KEY=
SOAR_PALOALTO_URL=
SOAR_PALOALTO_API_KEY=
SOAR_JIRA_URL=
SOAR_JIRA_USER=
SOAR_JIRA_TOKEN=
SOAR_N8N_URL=http://localhost:5678
SOAR_N8N_API_KEY=

# ── AWS ──
AWS_REGION=ap-south-1
SOAR_AWS_ACCOUNT_ID=
SOAR_AWS_ROLE_ARN=

# ── Notifications ──
SOAR_SLACK_WEBHOOK_URL=
SOAR_PAGERDUTY_ROUTING_KEY=
SOAR_SMTP_HOST=
SOAR_SMTP_PORT=587
SOAR_SMTP_USER=
SOAR_SMTP_PASSWORD=

# ── Safety rails ──
# When false, containment tools (block_ip, isolate_host, aws_remediate)
# run in dry-run mode and never touch production systems.
SOAR_ALLOW_DESTRUCTIVE_ACTIONS=false
SOAR_REQUIRE_APPROVAL_FOR_CONTAINMENT=true

# ── Frontend (build-time) ──
VITE_API_BASE_URL=http://localhost:8000
